# --- Ambiente --- (CONFIG)
ENVIRONMENT=development

# --- Banco de dados (PostgreSQL) --- (SENSITIVE)
# host = nome do container na rede docker, nunca localhost
DATABASE_URL=postgresql+asyncpg://ludens:ludens@ludens-postgres-dev:5432/ludens

# --- JWT (identity-auth) ---
# SECRET — gere com: openssl rand -hex 32
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS --- (CONFIG)
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Outbox in-process (ADR 001) --- (CONFIG)
OUTBOX_RELAY_INTERVAL_SECONDS=2