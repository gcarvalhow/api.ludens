# Ver docs.ludens/backend/security/configuration.md para a classificação
# (SECRET / SENSITIVE / CONFIG) e o significado de cada variável.

# CONFIG
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OUTBOX_RELAY_INTERVAL_SECONDS=2

# SENSITIVE — host = nome do container na rede docker, nunca localhost
DATABASE_URL=postgresql+asyncpg://ludens:ludens@dom-ludens-postgres-dev:5432/ludens

# SECRET — gere com: openssl rand -hex 32
JWT_SECRET_KEY=

# Adicionadas por feature (deixe em branco até a feature entrar):
# ABACATEPAY_API_KEY=
# ABACATEPAY_BASE_URL=
# ABACATEPAY_WEBHOOK_SECRET=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_SENDER=
