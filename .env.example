# Ver docs.ludens/backend/security/configuration.md para a classificação
# (SECRET / SENSITIVE / CONFIG) e o significado de cada variável.
# Cada feature acrescenta as próprias variáveis — ver docs.ludens/specs/.

# --- Ambiente --- (CONFIG)
ENVIRONMENT=development

# --- Banco de dados (PostgreSQL) --- (SENSITIVE)
# host = nome do container na rede docker, nunca localhost
DATABASE_URL=postgresql+asyncpg://ludens:ludens@dom-ludens-postgres-dev:5432/ludens

# --- JWT (identity-auth) ---
# SECRET — gere com: openssl rand -hex 32
JWT_SECRET_KEY=
# CONFIG
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS --- (CONFIG)
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Outbox in-process (ADR 001) --- (CONFIG)
OUTBOX_RELAY_INTERVAL_SECONDS=2

# --- Seed do admin (usado por scripts/seed_admin.py, fora do app) ---
# Nao sao lidos por app/config.py; passe no ambiente ao rodar o script.
# ADMIN_NAME=Administrador Ludens
# ADMIN_CPF=                     # SENSITIVE — so' digitos
# ADMIN_EMAIL=
# ADMIN_PASSWORD=                # SECRET

# --- Acrescentadas por feature (deixe em branco até a feature entrar) ---
# booking-reservation:
# RESERVATION_TTL_MINUTES=15
# MAX_TICKETS_PER_CPF=6
# payment-pix-checkout / payment-cancellation-refund:
# ABACATEPAY_API_KEY=            # SECRET
# ABACATEPAY_BASE_URL=           # CONFIG
# ABACATEPAY_WEBHOOK_SECRET=     # SECRET
# notification-transactional-email:
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=                 # SENSITIVE
# SMTP_PASSWORD=                 # SECRET
# EMAIL_SENDER=                  # CONFIG
